<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- JPA associations are managed mutable references by design. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Or>
            <Class name="dev.divyansh.sprintforge.attachment.Attachment"/>
            <Class name="dev.divyansh.sprintforge.audit.AuditEvent"/>
            <Class name="dev.divyansh.sprintforge.auth.RefreshToken"/>
            <Class name="dev.divyansh.sprintforge.comment.WorkItemComment"/>
            <Class name="dev.divyansh.sprintforge.project.Project"/>
            <Class name="dev.divyansh.sprintforge.sprint.Sprint"/>
            <Class name="dev.divyansh.sprintforge.task.WorkItem"/>
        </Or>
    </Match>
    <!-- Constructor-injected framework collaborators are intentionally retained. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="dev.divyansh.sprintforge.auth.TokenService"/>
            <Class name="dev.divyansh.sprintforge.config.WebSocketConfig"/>
            <Class name="dev.divyansh.sprintforge.realtime.ProjectEventPublisher"/>
        </Or>
    </Match>
    <!-- The rotated token is an internal transaction result, never serialized directly. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="dev.divyansh.sprintforge.auth.TokenService$RotatedToken"/>
    </Match>
</FindBugsFilter>
